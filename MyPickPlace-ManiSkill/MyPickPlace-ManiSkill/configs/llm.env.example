# Copy values into PowerShell environment variables; this file is documentation,
# not automatically loaded. Never put real keys in tracked files.
LLM_PROVIDER=ollama
LLM_MODEL=llama3:8b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_PROMPT_VERSION=two_stage
# The validated two-stage planner is the supported implementation.

# Alternative: an OpenAI-compatible server supporting strict JSON Schema.
# LLM_PROVIDER=openai
# LLM_MODEL=your-model-name
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=set-in-your-shell
